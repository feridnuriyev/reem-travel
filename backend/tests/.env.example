# Integration tests are opt-in and must point only to a disposable test environment.
REEM_RUN_INTEGRATION_TESTS=1
REEM_TEST_API_URL=http://localhost:8080
REEM_TEST_ADMIN_EMAIL=test-admin@example.com
REEM_TEST_ADMIN_PASSWORD=replace-with-a-test-only-password
REEM_TEST_TOTP_SECRET=replace-with-a-test-only-totp-secret
